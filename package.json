{
  "name": "reddit-lens",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup-backend.mjs",
    "setup:mcp": "node scripts/setup-mcp.mjs",
    "test:mcp": "benchmark_mcp/.venv/bin/python -m unittest discover -s benchmark_mcp/tests -v",
    "backend": "backend/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "test:backend": "backend/.venv/bin/python -m unittest discover -s backend/tests -v",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "0.1.14",
    "@types/node": "22.10.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
